#!/bin/bash
argument_to_read=1 # Skip the first one, which is the command used to execute this script.
function next_argument {
	argument=${!argument_to_read}
	argument_to_read=$(( argument_to_read + 1 ))
}

default_ffplay_arguments="-autoexit"
ffplay_arguments=
next_argument "$@" # The quotes ensure that multi-word arguments (e.g. "word1 word2") are kept together.
while [[ -n $argument ]] 
do
	if [[ $argument == "--ffplay" ]]
	then
		next_argument "$@"
		ffplay_arguments="$ffplay_arguments $argument"
		default_ffplay_arguments=
	elif [[ $argument == "--queue" ]]
	then
		next_argument "$@"
		queue=$argument
	fi
	next_argument "$@"
done

if [[ -z $queue ]]
then
	queue="$(pwd)/.queue"
fi

if [[ ! -f "$queue" ]]
then
	touch "$queue"
fi

echo "Reading queue from \"${queue}\"."

while true
do
	file=$(head -n 1 $queue)
	if [[ -n $file ]]
	then
		echo "Playing ${file}..."
		tail -n +2 $queue > ${queue}.tmp # Writing directly to $queue will clear it before evaluating the expression, which then reads from an empty file.
		mv ${queue}.tmp $queue
		ffplay $default_ffplay_arguments $ffplay_arguments "${file}" &> /dev/null
	else
		echo "Empty queue..."
		sleep 5
	fi
done
