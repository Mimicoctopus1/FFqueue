#!/bin/bash
function next_argument {
	if [[ -n $parse_arguments ]]
	then
		possible_arguments="$(echo "$1" | xargs -n1 2> /dev/null)" # The redirection is to stop `xargs` from complaining when `echo` is cut off by `head`.
		if [[ $to_read -le $(echo "$possible_arguments" | wc -l) ]]
		then
			argument="$(echo "$possible_arguments" | head -n $to_read | tail -n 1)"
		else
			argument=
		fi
	else
		argument=${!to_read}
	fi
	to_read=$(( to_read + 1 ))
}

parse_arguments= # `$@` comes with escaped characters and such already evaluated.
to_read=1 # The zero-th one will be the path to this script.
next_argument "$@" # Note there is an exception for `$@` such that it is expanded into multiple arguments, even if surrounded by quotes.
default_ffplay_arguments="-autoexit"
ffplay_arguments=
while [[ -n $argument ]] 
do
	if [[ $argument == "--ffplay" ]]
	then
		next_argument "$@"
		ffplay_arguments="$ffplay_arguments $argument"
		default_ffplay_arguments=
	elif [[ $argument == "--queue" ]]
	then
		next_argument "$@"
		queue=$argument
	fi
	next_argument "$@"
done

if [[ -z $queue ]]
then
	queue="$(pwd)/.queue"
fi
if [[ ! -f $queue ]]
then
	touch "$queue"
fi
echo "Reading queue from \"${queue}\"."

parse_arguments=1 # `read` doesn't separate arguments, so we'll do it in `next_arguments` manually.
while true
do
	file=$(head -n 1 $queue)
	if [[ -n $file ]]
	then
		echo "Playing ${file}..."
		tail -n +2 $queue > ${queue}.tmp # Writing directly to $queue will clear it before evaluating the expression, which then reads from an empty file.
		mv ${queue}.tmp $queue
		ffplay $default_ffplay_arguments $ffplay_arguments "${file}" &> /dev/null
	else
		echo "Empty queue..."
		sleep 5
	fi
done
