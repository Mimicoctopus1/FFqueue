#!/bin/bash
arguments=$@ # @Q preserves quotes
function next_argument {
	argument=$(echo $arguments | sed -e "s/^\s*\(\S*\).*$/\1/")
	argument_length=$(echo $arguments | sed -e "s/^\(\s*\S*\).*/\1/" | wc -m)
	arguments=$(echo $arguments | cut -c "$argument_length-") # wc returns one more characters than we need to delete, but we don't subtract because the new $arguments starts AFTER that many characters.
}

default_ffplay_arguments="-autoexit"
ffplay_arguments=
next_argument
while [[ -n $argument ]] 
do
	if [[ $argument == "--ffplay-argument" ]]
	then
		next_argument
		ffplay_arguments="$ffplay_arguments$argument"
		default_ffplay_arguments=
	elif [[ $argument == "--queue" ]]
	then
		next_argument
		queue=$argument
	fi
	next_argument
done

if [[ -z $queue ]]
then
	queue="$(pwd)/.queue"
fi

if [[ ! -f $queue ]]
then
	touch $queue
fi

echo "Reading queue from \"${queue}\"."

while true
do
	file=$(head -n 1 $queue)
	if [[ -n $file ]]
	then
		echo "Playing ${file}..."
		tail -n +2 $queue > ${queue}.tmp # Writing directly to $queue will clear it before evaluating the expression, which then reads from an empty file.
		mv ${queue}.tmp $queue
		ffplay $default_ffplay_arguments $ffplay_arguments "${file}" &> /dev/null
	else
		echo "Empty queue..."
		sleep 5
	fi
done
