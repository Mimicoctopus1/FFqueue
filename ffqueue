#!/bin/bash
function next_argument {
	if [[ -n $parse_arguments ]]
	then
		possible_arguments="$(echo "$1" | xargs -n1 2> /dev/null)" # The redirection is to stop `xargs` from complaining when `echo` is cut off by `head`.
		if [[ $to_read -le $(echo "$possible_arguments" | wc -l) ]]
		then
			argument="$(echo "$possible_arguments" | head -n $to_read | tail -n 1)"
		else
			argument=
		fi
	else
		argument=${!to_read}
	fi
	to_read=$(( to_read + 1 ))
}

parse_arguments= # `$@` comes with escaped characters and such already evaluated.
to_read=1 # The zero-th one will be the path to this script.
next_argument "$@" # Note there is an exception for `$@` such that it is expanded into multiple arguments, even if surrounded by quotes.
while [[ -n $argument ]] 
do
	if [[ $argument == "--queue" ]]
	then
		next_argument "$@"
		queue=$argument
	fi
	next_argument "$@"
done

if [[ -z $queue ]]
then
	queue="$(pwd)/.queue"
fi
if [[ ! -f $queue ]]
then
	touch "$queue"
fi
echo "Writing queue to \"${queue}\"."

parse_arguments=1 # `read` doesn't separate arguments, so we'll do it in `next_arguments` manually.
while true
do
	echo -n "> "
	read -r arguments # `-r` makes it so that backslashes will be interpreted as literal backslash characters.
	to_read=1 # The zero-th one will be the function, "next_argument", itself, which will be the path to this script.
	next_argument "$arguments"
	command="$argument"
	if [[ $command == "help" ]] # Forgive my wasteful "if" structures. /(^-^')7
	then
		echo "{list|ls}: List the files in the queue, with entry numbers."
		echo "{add}: Add to the queue."
		echo "{remove|rm}: Remove from the queue."
		echo "{exit|quit}: Quit the program and delete the queue file."
	fi
	if [[ $command == "list" || $command == "ls" ]]
	then
		nl --body-numbering="a" $queue
	fi
	if [[ $command == "add" ]]
	then
		next_argument "$arguments"
		if [[ -n $argument ]]
		then
			file="$argument"
		else
			file=$(fzf --border="rounded" --border-label="Choose a file to add." --border-label-pos=3:bottom)
			to_read=$(( $to_read - 1 ))
		fi
		default_location=$(wc -l $queue | sed -e "s/ .*//")
		if [[ -n $file ]]
		then
			echo -n "Add after [${default_location}]: " 
			read location
			if [[ -z $location ]]
			then
				location=$default_location
			fi

			echo "Add \"${file}\" after number ${location}."

			head -n $location $queue > ${queue}.tmp
			echo $file >> ${queue}.tmp
			tail -n +$(( $location + 1 )) $queue >> ${queue}.tmp
			mv ${queue}.tmp $queue
		else
			echo "No file was specified for adding." > /dev/stderr
		fi
	fi
	if [[ $command == "remove" || $command == "rm" ]]
	then
		default_location=$(wc -l $queue | sed -e "s/ .*//")
		echo -n "Remove [${default_location}]: " 
		read location
		if [[ -z $location ]]
		then
			location=$default_location
		fi
		file=$(head -n $location $queue | tail -n 1)

		echo "Remove \"${file}\" at number ${location}."

		head -n $(( $location - 1 )) $queue > ${queue}.tmp
		tail -n +$(( $location + 1 )) $queue >> ${queue}.tmp
		mv ${queue}.tmp $queue
	fi
	if [[ $command == "quit" || $command == "exit" ]]
	then
		exit_code=
		next_argument "$arguments"
		if [[ -n $argument ]]
		then
			exit_code=$(echo $argument | sed -e "s/[^0-9]//g")
		else
			exit_code=0
		fi
		rm $queue
		rm ${queue}.tmp &> /dev/null
		exit $exit_code
	fi
done
