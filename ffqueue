#!/bin/bash
queue="$(pwd)/.queue"
if [[ -n $1 ]]
then
	queue=$1
fi

if [[ ! -f $queue ]]
then
	touch $queue
fi

echo "Writing queue to \"${queue}\"."

while true
do
	echo -n "> "
	read input
	command=$(echo $input | sed -e "s/^\s*\(\S*\).*$/\1/")
	parameters=$(echo $input | sed -e "s/^\s*\S*\s*\(.*\)$/\1/")
	if [[ $command == "help" ]] # Forgive my wasteful "if" structures. /(^-^')7
	then
		echo "list: List the files in the queue, with entry numbers."
		echo "add: Add to the queue."
		echo "remove: Remove from the queue."
		echo "quit: Quit the program and delete the queue file."
	fi
	if [[ $command == "list" ]]
	then
		nl --body-numbering="a" $queue
	fi
	if [[ $command == "add" ]]
	then
		if [[ -z $(echo $parameters | sed -e "s/\s//g") ]]
		then
			file=$(fzf --border="rounded" --border-label="Choose a file to add." --border-label-pos=3:bottom)
		else
			file=$(echo $parameters | sed -e "s/\s\+/ /g")
		fi
		default_location=$(wc -l $queue | sed -e "s/ .*//")
		if [[ -n $file ]]
		then
			echo -n "Add after [${default_location}]: " 
			read location
			if [[ -z $location ]]
			then
				location=$default_location
			fi

			echo "Add \"${file}\" after number ${location}."

			head -n $location $queue > ${queue}.tmp
			echo $file >> ${queue}.tmp
			tail -n +$(( $location + 1 )) $queue >> ${queue}.tmp
			mv ${queue}.tmp $queue
		else
			echo "No file was specified for adding." > /dev/stderr
		fi
	fi
	if [[ $command == "remove" ]]
	then
		default_location=$(wc -l $queue | sed -e "s/ .*//")
		echo -n "Remove [${default_location}]: " 
		read location
		if [[ -z $location ]]
		then
			location=$default_location
		fi
		file=$(head -n $location $queue | tail -n 1)

		echo "Remove \"${file}\" at number ${location}."

		head -n $(( $location - 1 )) $queue > ${queue}.tmp
		tail -n +$(( $location + 1 )) $queue > ${queue}.tmp
		mv ${queue}.tmp $queue
	fi
	if [[ $command == "quit" ]]
	then
		exit_code=
		if [[ -n $(echo $parameters | sed -e "s/\s//g") ]]
		then
			if [[ -z $(echo $parameters | sed -e "s/^[0-9]\+\s*$//g") ]]
			then
				exit_code=$(echo $parameters | sed -e "s/^\([0-9]+\)\s*$/\1/g")
			else
				echo "An exit code could not be extracted these parameters: ${parameters}"
			fi
		else
			exit_code=0
		fi
		if [[ -n $exit_code ]]
		then
			rm $queue
			rm ${queue}.tmp &> /dev/null
			exit $exit_code
		fi
	fi
done
